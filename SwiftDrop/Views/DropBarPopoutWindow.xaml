<Window x:Class="SwiftDrop.Views.DropBarPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SwiftDrop.Models"
        xmlns:helpers="clr-namespace:SwiftDrop.Helpers"
        Title="SwiftDrop — Drop Bar"
        Width="220" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Border CornerRadius="16"
            BorderThickness="1"
            Margin="6">
        <Border.Background>
            <SolidColorBrush Color="#E81A1A2E"/>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#40FFFFFF" Offset="0"/>
                <GradientStop Color="#15FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Clear All -->
            </Grid.RowDefinitions>

            <!-- Title bar (drag to move) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Drop Bar (Floating)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>

                <Button Grid.Column="1" Width="28" Height="28"
                        Click="Close_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,8,0">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                </Button>
            </Grid>

            <!-- File list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="6,0,6,0">
                <ItemsControl ItemsSource="{Binding StashedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DroppedFileItem}">
                            <Border Margin="2,2" Padding="6,4" CornerRadius="8"
                                    Background="#12FFFFFF"
                                    Cursor="Hand"
                                    MouseMove="Item_MouseMove">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Lock" IsCheckable="True"
                                                  IsChecked="{Binding IsLocked}"/>
                                        <Separator/>
                                        <MenuItem Header="Remove"
                                                  Click="RemoveItem_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FileIconGlyph}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="4,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding LockIconGlyph}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="8"
                                               Foreground="#6C63FF"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Clear All -->
            <Button Grid.Row="2" Content="Clear All" FontSize="11"
                    HorizontalAlignment="Stretch" Margin="10,4,10,10"
                    Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding ClearAllCommand}"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Border>
</Window>

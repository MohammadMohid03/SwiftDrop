<UserControl x:Class="SwiftDrop.Views.ActionGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SwiftDrop.Models">

    <Grid Margin="8,8,8,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,4,8,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Actions"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Drop a file on a tile or click a tile to process the current stack."
                           Margin="0,3,0,0"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
            <Border Grid.Column="1"
                    VerticalAlignment="Center"
                    Padding="10,5"
                    CornerRadius="999"
                    Background="#72F1F7FF"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1">
                <TextBlock Text="Fast lane"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#FF3F6FD0"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ActionsItemsControl"
                          ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="6,4,6,8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ActionDefinition}">
                        <Border x:Name="TileBorder"
                                Margin="6"
                                Width="156"
                                Height="132"
                                CornerRadius="22"
                                AllowDrop="True"
                                Cursor="Hand"
                                BorderThickness="1"
                                Background="#8FFFFFFF"
                                BorderBrush="#20FFFFFF"
                                DragOver="ActionTile_DragOver"
                                DragLeave="ActionTile_DragLeave"
                                Drop="ActionTile_Drop"
                                Tag="{Binding}"
                                Loaded="ActionTile_Loaded"
                                MouseEnter="ActionTile_MouseEnter"
                                MouseLeave="ActionTile_MouseLeave"
                                MouseLeftButtonUp="ActionTile_MouseLeftButtonUp"
                                RenderTransformOrigin="0.5,0.5"
                                Opacity="0">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False"/>
                            </Border.CacheMode>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <Border Margin="0"
                                        CornerRadius="22">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#C8FFFFFF" Offset="0"/>
                                            <GradientStop Color="#8CF6FAFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Ellipse Width="96"
                                         Height="96"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-28,-24,0"
                                         Opacity="0.11"
                                         Fill="{Binding AccentColor, Converter={StaticResource StringToBrushConverter}}"/>

                                <Border Width="44"
                                        Height="44"
                                        Margin="14,14,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        CornerRadius="14"
                                        Background="#84FFFFFF"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1">
                                    <Grid>
                                        <Ellipse Width="28"
                                                 Height="28"
                                                 Fill="{Binding AccentColor, Converter={StaticResource StringToBrushConverter}}"
                                                 Opacity="0.14"/>
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{Binding AccentColor, Converter={StaticResource StringToBrushConverter}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Width="4"
                                        Margin="0,16,0,16"
                                        HorizontalAlignment="Left"
                                        CornerRadius="999"
                                        Opacity="0.72"
                                        Background="{Binding AccentColor, Converter={StaticResource StringToBrushConverter}}"/>

                                <StackPanel Margin="14,66,14,14">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,6,0,0"
                                               FontSize="10"
                                               LineHeight="14"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               MaxHeight="42"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

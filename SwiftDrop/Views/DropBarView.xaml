<UserControl x:Class="SwiftDrop.Views.DropBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SwiftDrop.Models"
             AllowDrop="True"
             DragOver="DropBar_DragOver"
             Drop="DropBar_Drop"
             Focusable="True"
             PreviewKeyDown="DropBar_PreviewKeyDown">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,16,16,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Drop Bar"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Stage files before sending them to an action"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="PopOut_Click"
                        ToolTip="Pop out Drop Bar"
                        Margin="0,0,6,0"
                        Style="{StaticResource ToolbarIconButtonStyle}">
                    <TextBlock Text="&#xE8A7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <Border Grid.Column="2"
                        Padding="10,5"
                        CornerRadius="999"
                        Background="#72F1F8FF"
                        BorderBrush="#1EFFFFFF"
                        BorderThickness="1"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} ready'}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF3B5CB8"/>
                </Border>
            </Grid>

            <Border Padding="12"
                    CornerRadius="18"
                    Background="#72FFFFFF"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tip"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSoftBrush}"/>
                    <TextBlock Text="Press Space to quick-look the first item, or drag the stack onto any action tile."
                               Margin="0,4,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="14,14,14,10"
                CornerRadius="22"
                Background="#62FFFFFF"
                BorderBrush="#24FFFFFF"
                BorderThickness="1">
            <Grid>
                <Border Margin="12"
                        CornerRadius="18"
                        BorderThickness="1.5"
                        Padding="18"
                        VerticalAlignment="Center"
                        AllowDrop="True"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                    <Border.BorderBrush>
                        <VisualBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute" Viewbox="0,0,10,10" ViewboxUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid>
                                    <Rectangle Width="5" Height="10" Fill="#220F172A" HorizontalAlignment="Left"/>
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#B9FCFFFF" Offset="0"/>
                            <GradientStop Color="#96F8F1E8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="64" Height="64"
                                Background="#82FFFFFF"
                                CornerRadius="20">
                            <TextBlock Text="&#xE898;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="24"
                                       Foreground="#FF5B7FE8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Drop files here"
                                   Margin="0,14,0,0"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Build a temporary stack, then drag it into an action."
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Margin="10"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            x:Name="StackPile"
                            Cursor="Hand"
                            Margin="6,4,6,12"
                            MouseMove="StackPile_MouseMove"
                            MouseLeftButtonDown="StackPile_MouseDown"
                            MouseEnter="StackPile_MouseEnter"
                            MouseLeave="StackPile_MouseLeave"
                            ToolTip="Drag this stack onto an action to process all files"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="StackPileScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid HorizontalAlignment="Center" Height="128" Width="132">
                            <Ellipse Width="88" Height="24" Fill="#100F172A"
                                     VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                            <Border Background="#74F5FBFF" CornerRadius="18"
                                    BorderBrush="#20FFFFFF" BorderThickness="1"
                                    Width="84" Height="98"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="-7"/>
                                        <TranslateTransform X="-10" Y="10"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                            <Border Background="#74FFF5EB" CornerRadius="18"
                                    BorderBrush="#20FFFFFF" BorderThickness="1"
                                    Width="84" Height="98"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="6"/>
                                        <TranslateTransform X="10" Y="6"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                            <Border Background="#96FFFFFF" CornerRadius="20"
                                    BorderBrush="#26FFFFFF" BorderThickness="1.2"
                                    Width="90" Height="104"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="42" Height="42"
                                            CornerRadius="14"
                                            Background="#82FFFFFF"
                                            Margin="0,0,0,10">
                                        <TextBlock Text="&#xE8B7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="#FF5B7FE8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} files'}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Drag to an action"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding StashedItems}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MaxHeight="170"
                             Margin="2,0,2,0"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DroppedFileItem}">
                                    <Border Margin="0,0,0,6"
                                            Padding="10,8"
                                            CornerRadius="14"
                                            Background="#86FFFFFF"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="1"
                                            Loaded="FileRow_Loaded"
                                            MouseEnter="FileRow_MouseEnter"
                                            MouseLeave="FileRow_MouseLeave"
                                            RenderTransformOrigin="0.5,0.5"
                                            Opacity="0">
                                        <Border.CacheMode>
                                            <BitmapCache EnableClearType="False"/>
                                        </Border.CacheMode>
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform Y="0"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Lock (keep on drag)"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding IsLocked}"/>
                                                <Separator/>
                                                <MenuItem Header="Remove"
                                                          Click="RemoveItem_ContextClick"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    CornerRadius="8"
                                                    Background="#78FFFFFF">
                                                <TextBlock Text="{Binding FileIconGlyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           Foreground="#FF5B7FE8"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                                <TextBlock Text="{Binding Path}"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Margin="8,0,0,0"
                                                    Padding="8,4"
                                                    CornerRadius="999"
                                                    Background="#72F2FAF1"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Locked - drag copies file">
                                                <TextBlock Text="Locked"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF2D8C72"/>
                                            </Border>

                                            <Button Grid.Column="3"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="8,0,0,0"
                                                    Tag="{Binding}"
                                                    Click="RemoveItem_Click"
                                                    Cursor="Hand"
                                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                                    ToolTip="Remove">
                                                <TextBlock Text="&#xE711;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="8"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Stacks}"
                             Margin="2,10,2,0"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FileStack}">
                                <Border Margin="0,0,0,6"
                                        Padding="10,8"
                                        CornerRadius="14"
                                        Background="#7AF8F4EE"
                                        BorderBrush="#20FFFFFF"
                                        BorderThickness="1"
                                        Loaded="StackRow_Loaded"
                                        MouseEnter="StackRow_MouseEnter"
                                        MouseLeave="StackRow_MouseLeave"
                                        RenderTransformOrigin="0.5,0.5"
                                        Opacity="0">
                                    <Border.CacheMode>
                                        <BitmapCache EnableClearType="False"/>
                                    </Border.CacheMode>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform Y="0"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Unpack Stack" Click="UnpackStack_Click"/>
                                            <MenuItem Header="Remove Stack" Click="RemoveStack_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="8"
                                                Background="#72FFFFFF">
                                            <TextBlock Text="&#xE8B7;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       Foreground="#FF2D8C72"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding Name}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Count, StringFormat='{}{0}'}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="14,0,14,14"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Content="Stack All"
                    FontSize="11"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,6"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding CreateStackCommand}"/>

            <Button Content="Clear All"
                    FontSize="11"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding ClearAllCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>

<Window x:Class="SwiftDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SwiftDrop.Views"
        Title="SwiftDrop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="880"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <StackPanel x:Name="RootStack">
            <Border x:Name="TriggerBar"
                    HorizontalAlignment="Center"
                    Width="260"
                    Height="40"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonDown="TriggerBar_Click"
                    MouseEnter="TriggerBar_MouseEnter"
                    MouseLeave="TriggerBar_MouseLeave">
                <Border x:Name="TriggerPill"
                        Width="110"
                        Height="32"
                        CornerRadius="0,0,16,16"
                        VerticalAlignment="Top"
                        Opacity="0.22"
                        Background="#7AFFFFFF"
                        BorderBrush="#42FFFFFF"
                        BorderThickness="1"
                        RenderTransformOrigin="0.5,0.2">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="TriggerPillScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Grid>
                        <TextBlock x:Name="TriggerArrow"
                                   Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#8A93A7"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="ArrowRotation" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Border>
            </Border>

            <Border x:Name="MainPanel"
                    Visibility="Collapsed"
                    Margin="10,0,10,16"
                    Height="560"
                    CornerRadius="0,0,28,28"
                    ClipToBounds="True"
                    RenderTransformOrigin="0.5,0"
                    Opacity="0"
                    Background="{StaticResource WindowBackgroundBrush}"
                    BorderBrush="#54FFFFFF"
                    BorderThickness="1">
                <Border.CacheMode>
                    <BitmapCache EnableClearType="False"/>
                </Border.CacheMode>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PanelScale" ScaleX="0.985" ScaleY="0.985"/>
                        <TranslateTransform x:Name="PanelTranslate" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#AFFFFFFF" Offset="0"/>
                            <GradientStop Color="#98EFF6FD" Offset="0.6"/>
                            <GradientStop Color="#92F7F1E8" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Ellipse Width="280" Height="280" Fill="#12A8CEFF"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-70,-110,0,0" IsHitTestVisible="False"/>
                    <Ellipse Width="220" Height="220" Fill="#0EFFC46B"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-70,-40" IsHitTestVisible="False"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#58FFFFFF"
                                BorderBrush="#2EFFFFFF"
                                BorderThickness="0,0,1,0"
                                CornerRadius="0,0,0,28">
                            <views:DropBarView x:Name="DropBarView"/>
                        </Border>

                        <Border Grid.Column="1" Background="#100F172A"/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="20,16,18,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SwiftDrop"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Quick file actions in a calmer, desktop-first workspace"
                                               Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource ToolbarIconButtonStyle}"
                                        ToolTip="Reload actions"
                                        Command="{Binding ActionGridViewModel.ReloadScriptActionsCommand}">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>

                                <Border Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Padding="10,5"
                                        CornerRadius="999"
                                        Background="#78FFFFFF"
                                        BorderBrush="#120F172A"
                                        BorderThickness="1">
                                    <TextBlock Text="Drop. Convert. Move."
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>

                                <Button Grid.Column="3"
                                        Width="32"
                                        Height="32"
                                        Margin="10,0,0,0"
                                        Click="CloseButton_Click"
                                        ToolTip="Close SwiftDrop"
                                        Style="{StaticResource ToolbarIconButtonStyle}">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="18,0,18,10"
                                    Padding="6"
                                    Background="#68FFFFFF"
                                    BorderBrush="#120F172A"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                <StackPanel x:Name="GridTabsPanel" Orientation="Horizontal">
                                    <Button Width="28"
                                            Height="28"
                                            Margin="2,0,0,0"
                                            Click="AddGrid_Click"
                                            ToolTip="Add new grid"
                                            Style="{StaticResource ToolbarIconButtonStyle}">
                                        <TextBlock Text="&#xE710;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Margin="12,0,12,12"
                                    Background="#4DFFFFFF"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="22">
                                <views:ActionGridView x:Name="ActionGridView"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
